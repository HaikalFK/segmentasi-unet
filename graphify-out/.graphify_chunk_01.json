    {"id": "docs_penjelasan_model_une", "label": "Penjelasan Model U-Net Standar (Standard U-Net Deep Dive)", "file_type": "document", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_penjelasan_model_une_standard_unet", "label": "Standard U-Net (Ronneberger et al., MICCAI 2015)", "file_type": "paper", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_penjelasan_model_une_unet", "label": "UNet Assembly Class", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encoder/decoder symmetry with factor = 2 if bilinear else 1 to save memory at the bottleneck when using bilinear upsampling."},
    {"id": "docs_penjelasan_model_une_doubleconv", "label": "DoubleConv", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two conv(3x3)+BN+ReLU blocks; bias=False because BatchNorm already provides the shift; first conv expands representation, second refines non-linearly."},
    {"id": "docs_penjelasan_model_une_down", "label": "Down (Encoder Block)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_penjelasan_model_une_up", "label": "Up (Decoder Block)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Padding-aligned concat with skip features; bilinear mode uses 1x1 conv to reduce channels, transposed mode learns the upsampling kernel."},
    {"id": "docs_penjelasan_model_une_outconv", "label": "OutConv", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1x1 convolution maps channels to n_classes without changing resolution; no activation since loss functions handle softmax internally."},
    {"id": "docs_penjelasan_model_une_skip_connections", "label": "Skip Connections", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Connect encoder features to decoder at the same resolution to preserve spatial detail lost during downsampling."},
    {"id": "docs_penjelasan_model_une_bilinear_vs_transposed", "label": "Bilinear vs Transposed Conv Upsampling", "file_type": "rationale", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bilinear is deterministic and parameter-light but not learned; transposed conv learns upsampling but can produce checkerboard artifacts."},
    {"id": "docs_penjelasan_model_une_gradient_checkpointing", "label": "Gradient Checkpointing (use_checkpointing)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trade-off: ~20-30% more compute but ~40-50% less GPU memory by recomputing forward activations during backward."},
    {"id": "docs_penjelasan_model_une_dice_loss", "label": "Dice Loss / dice_coeff", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Directly optimizes overlap so it is robust to class imbalance, but gradients are small when overlap is small early in training."},
    {"id": "docs_penjelasan_model_une_combined_loss", "label": "Combined Loss (Weighted BCE + Dice)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best of both worlds: BCE stable per-pixel signal, Dice handles imbalance; class weights are inverse-frequency clamped to [0.3, 3.0]."},
    {"id": "docs_penjelasan_model_une_amp", "label": "Mixed Precision Training (AMP)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FP16 forward/activations cut memory ~50% and boost throughput ~1.5-2x via Tensor Cores; GradScaler provides numerical stability."},
    {"id": "docs_penjelasan_model_une_basicdataset", "label": "BasicDataset", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_penjelasan_model_une_binaryleafdataset", "label": "BinaryLeafDataset", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapper converting multi-class masks (0-27) to binary (0=bg, 1=leaf) via (mask > 0).astype(int64); BICUBIC image resize, NEAREST mask resize."},
    {"id": "docs_penjelasan_model_une_binary_metrics", "label": "Binary Metrics (IoU & Dice)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dice = 2*IoU/(1+IoU) so Dice is always >= IoU; IoU is the final metric of interest."},
    {"id": "docs_penjelasan_model_une_rmsprop", "label": "RMSprop + ReduceLROnPlateau Config", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RMSprop lr=1e-5 momentum=0.999 weight_decay=1e-8 matches original U-Net paper; low LR for transfer-learning context; plateau scheduler drops LR when Dice plateaus."},
    {"id": "docs_penjelasan_model_une_attention_gate", "label": "Attention Gate", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_penjelasan_model_une_attention_unet", "label": "Attention U-Net (Oktay et al., 2018)", "file_type": "paper", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_penjelasan_model_une_unetpp", "label": "U-Net++ (Zhou et al., 2018)", "file_type": "paper", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_penjelasan_model_une_enhanced_unet", "label": "Enhanced U-Net", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upgrade path from standard U-Net: add Attention Gates in Up blocks, residual DoubleConv, deep supervision, dropout."},
    {"id": "docs_penjelasan_model_une_milesial_pytorch_unet", "label": "milesial/Pytorch-UNet Reference", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\penjelasan_model_une.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
