{
  "nodes": [
    {"id": "docs_binary_segmentation_pipeline", "label": "Binary Leaf Segmentation Pipeline (U-Net)", "file_type": "document", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_binary_segmentation_pipeline_unet", "label": "Binary U-Net Model (2 classes: background + leaf)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instance labels (leaf 1,2,3,...) are not semantically consistent across images, so a standard U-Net cannot learn them as classes; converting to binary foreground-vs-background is what standard U-Net handles well."},
    {"id": "docs_binary_segmentation_pipeline_binaryleafdataset", "label": "BinaryLeafDataset", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Converts instance masks (0..27) to binary on-the-fly with (mask > 0) so original mask files on disk are never modified; uses NEAREST resize to preserve label integrity."},
    {"id": "docs_binary_segmentation_pipeline_combined_loss", "label": "Weighted BCE + Dice Combined Loss", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BCE provides pixel-level gradient signal while Dice provides region-level overlap optimization; together they produce smooth, complete leaf masks."},
    {"id": "docs_binary_segmentation_pipeline_background_collapse", "label": "Background Collapse Problem", "file_type": "rationale", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_binary_segmentation_pipeline_inverse_frequency_weighting", "label": "Inverse Frequency Class Weighting", "file_type": "rationale", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With >99% background pixels unweighted BCE learns to predict background everywhere; weight = total/(2*n_class) clamped to [0.3, 3.0] makes misclassifying a leaf pixel cost ~10x more."},
    {"id": "docs_binary_segmentation_pipeline_two_stage_approach", "label": "Two-Stage Approach (Binary Segmentation + Watershed)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stage 1 gives pixel-wise background/leaf mask; Stage 2 Watershed separates overlapping leaves into instance labels 1..N."},
    {"id": "docs_binary_segmentation_pipeline_watershed_post_processing", "label": "Watershed Post-Processing", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_binary_segmentation_pipeline_distance_transform", "label": "Distance Transform (cv2.DIST_L2)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_binary_segmentation_pipeline_marker_generation", "label": "Marker Generation", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Threshold at 40% of max distance then connected components gives one seed per leaf; lower to 25% for heavier overlap."},
    {"id": "docs_binary_segmentation_pipeline_watershed_algorithm", "label": "Watershed Algorithm", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_binary_segmentation_pipeline_amp", "label": "Mixed Precision Training (AMP)", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Float16 softmax+CrossEntropy can overflow to NaN, so the loop checks gradients before stepping and skips problematic batches."},
    {"id": "docs_binary_segmentation_pipeline_gradient_health_checks", "label": "Gradient Health Checks (NaN/Inf skipping)", "file_type": "rationale", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_binary_segmentation_pipeline_early_stopping", "label": "Dice-Based Early Stopping & Model Selection", "file_type": "rationale", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IoU is the final metric of interest but Dice is more stable for small foreground regions during training; best_dice initialized to -1.0 so epoch 1 always saves."},
    {"id": "docs_binary_segmentation_pipeline_best_binary", "label": "best_binary.pth Checkpoint", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_binary_segmentation_pipeline_instance_semantic", "label": "Instance vs Semantic Segmentation", "file_type": "concept", "source_file": "C:\\Users\\Musa\\OneDrive - Universitas Teknologi Yogyakarta (1)\\segementasi\\segmentasi-unet\\docs\\binary-segmentation-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leaf instance IDs are arbitrary per image so U-Net cannot treat them as semantic classes; binary conversion avoids the instance segmentation requirement."},
