{"nodes": [{"id": "docs_penjelasan_model_unet_md_encoder_decoder_architecture", "label": "U-Net Encoder-Decoder Architecture", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "U-Net is an encoder-decoder architecture with skip connections designed for biomedical image segmentation. The encoder extracts hierarchical features via downsampling; the decoder reconstructs spatial detail via upsampling. Skip connections preserve fine-grained detail by linking encoder features to corresponding decoder levels."}, {"id": "docs_penjelasan_model_unet_md_skip_connections", "label": "Skip Connections", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skip connections concatenate encoder feature maps with decoder feature maps at the same spatial resolution, preserving spatial detail that would otherwise be lost through downsampling."}, {"id": "docs_penjelasan_model_unet_md_doubleconv", "label": "DoubleConv", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_down", "label": "Down (Encoder Block)", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_up", "label": "Up (Decoder Block)", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_outconv", "label": "OutConv", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_unet_model", "label": "UNet Class", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_dice_bce_loss", "label": "Dice Loss + BCE Combined Loss", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BCE provides stable per-pixel gradients early in training; Dice loss directly optimizes overlap robust to class imbalance. Combining both yields stable convergence and strong overlap metrics."}, {"id": "docs_penjelasan_model_unet_md_rmsprop_optimizer", "label": "RMSprop Optimizer", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_reduce_lr_on_plateau", "label": "ReduceLROnPlateau Scheduler", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_amp", "label": "Automatic Mixed Precision (AMP)", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AMP reduces memory by ~50% and increases throughput 1.5-2x via FP16 on GPU Tensor Cores, but fp16 overflow (>65504 logits) can cause NaN after convergence (~0.95 Dice), so it is disabled in production configs."}, {"id": "docs_penjelasan_model_unet_md_basic_dataset", "label": "BasicDataset", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_binary_leaf_dataset", "label": "BinaryLeafDataset", "file_type": "code", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps multi-class masks (0-27 leaf types) into binary (0=background, 1=leaf) for binary segmentation training."}, {"id": "docs_penjelasan_model_unet_md_iou_metric", "label": "IoU (Jaccard Index)", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_dice_metric", "label": "Dice Coefficient (F1 Score)", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_attention_gates", "label": "Attention Gates", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied in skip connections before concatenation in the Up block to focus the decoder on foreground (leaf) regions, suppressing irrelevant background features."}, {"id": "docs_penjelasan_model_unet_md_unet_plus_plus", "label": "U-Net++ (Nested Skip Connections)", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_enhanced_unet", "label": "Enhanced U-Net", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_deep_supervision", "label": "Deep Supervision", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_class_weighting_inverse_frequency", "label": "Class Weighting (Inverse Frequency)", "file_type": "rationale", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Foreground (leaf) pixels are fewer than background, so inverse-frequency weighting gives higher weight to the minority class. Clamping to [0.3, 3.0] prevents extreme weights from destabilizing training."}, {"id": "docs_penjelasan_model_unet_md_gradient_checkpointing", "label": "Gradient Checkpointing", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recomputes forward activations during backward pass instead of storing all layer activations. Trades 20-30% more compute for 40-50% GPU memory reduction."}, {"id": "docs_penjelasan_model_unet_md_test_time_augmentation", "label": "Test-Time Augmentation (TTA)", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_residual_doubleconv", "label": "Residual DoubleConv", "file_type": "concept", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_penjelasan_model_unet_md_ronneberger_2015", "label": "Ronneberger et al., 2015 (Original U-Net Paper)", "file_type": "paper", "source_file": "docs/penjelasan_model_unet.md", "source_location": null, "source_url": null, "capture