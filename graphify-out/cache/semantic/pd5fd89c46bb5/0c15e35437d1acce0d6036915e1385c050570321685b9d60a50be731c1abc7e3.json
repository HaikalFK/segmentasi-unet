{"nodes": [{"id": "docs_tumpangtinding_md_instance_segmentation", "label": "Instance Segmentation", "file_type": "concept", "source_file": "docs/tumpangtinding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic multiclass segmentation cannot separate overlapping leaf instances. Instance segmentation assigns unique IDs to each individual leaf, enabling counting and per-leaf measurement."}, {"id": "docs_tumpangtinding_md_mask_color_to_instance", "label": "Mask Color-to-Instance Conversion", "file_type": "rationale", "source_file": "docs/tumpangtinding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current masks use ~13 recurring colors to represent leaves. Since colors are per-image palette (not consistent class labels), they must be remapped to per-instance IDs before instance-level training or evaluation."}, {"id": "docs_tumpangtinding_md_distance_transform", "label": "Distance Transform", "file_type": "concept", "source_file": "docs/tumpangtinding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tumpangtinding_md_watershed_postprocessing", "label": "Watershed Post-processing", "file_type": "concept", "source_file": "docs/tumpangtinding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines predicted binary mask with predicted distance map to separate overlapping leaf instances via watershed segmentation. This is the recommended approach for separating touching/overlapping leaves."}, {"id": "docs_tumpangtinding_md_mask_rcnn_detectron2", "label": "Mask R-CNN / Detectron2", "file_type": "concept", "source_file": "docs/tumpangtinding.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tumpangtinding_md